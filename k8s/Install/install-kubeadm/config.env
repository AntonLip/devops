# Конфигурация kubeadm lab — сеть Anton homelab (192.168.1.0/24)
# Использование: source config.env  (скрипты подхватывают автоматически)
#


export NODE_NETWORK="192.168.1.0/24"
export GATEWAY="${GATEWAY:-192.168.1.1}"

export CP_HOSTNAME="k8s-cp-01"
export WORKER1_HOSTNAME="k8s-w-01"
export WORKER2_HOSTNAME="k8s-w-02"

export CP_IP="192.168.1.20"
export WORKER1_IP="192.168.1.21"
export WORKER2_IP="192.168.1.22"

export POD_CIDR="10.244.0.0/16"
export SERVICE_CIDR="10.96.0.0/12"
export K8S_VERSION="${K8S_VERSION:-v1.32.4}"
export CRI_SOCKET="${CRI_SOCKET:-unix:///run/containerd/containerd.sock}"

# Talos homelab (справочно — не трогать при kubeadm lab)
export TALOS_CP_IP="192.168.1.9"
export TALOS_API="https://192.168.1.9:6443"

# VirtualBox lab (см. vbox/create-vbox-vms.sh)
export VM_USER="${VM_USER:-k8s}"
export VM_PASSWORD="${VM_PASSWORD:-k8s}"
